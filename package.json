{
  "name": "conduit-desktop",
  "productName": "Conduit",
  "desktopName": "dev.conduit",
  "version": "1.0.3",
  "private": true,
  "description": "Conduit for Mac, Windows and Linux: a desktop client for Hermes Agent",
  "license": "MIT",
  "author": "kaishi00",
  "homepage": "https://github.com/kaishi00/hermes-conduit-desktop",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "install:linux-desktop": "pnpm build && node scripts/install-linux-desktop.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "package": "npm run build && electron-builder --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "qrcode": "1.5.4",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@novnc/novnc": "1.7.0",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.10.1",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "happy-dom": "21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "vosk-browser": "0.0.8"
  },
  "packageManager": "pnpm@10.28.0"
}
